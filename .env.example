# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용한다.

# PostgreSQL
POSTGRES_DB=database_name
POSTGRES_USER=user_name_here
POSTGRES_PASSWORD=password_here

# cloudflared 터널 토큰
TUNNEL_TOKEN=replace_with_your_tunnel_token

# JWT 설정
JWT_SECRET=replace_with_at_least_32_random_characters

# 토큰 유효 기간 (기본값: access 15분, refresh 14일)
# ex. ACCESS_TOKEN_MINUTES=15
#     REFRESH_TOKEN_DAYS=14
ACCESS_TOKEN_MINUTES=time_in_minutes_here
REFRESH_TOKEN_DAYS=time_in_days_here

# OAuth 설정
GOOGLE_CLIENT_ID=your_google_client_id_here

# 관리자 이메일 설정
ADMIN_EMAILS=example@example.com,example2@example.com

# 인증 쿠키 설정
AUTH_COOKIE_SECURE=true_is_required_for_https
